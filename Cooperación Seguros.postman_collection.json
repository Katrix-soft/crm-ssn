				{
					"name": "Cotizar Vehículo",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (Array.isArray(res) && res.length > 0) {",
									"    const presupuesto = res[0].presupuestoNro;",
									"    if (presupuesto && presupuesto !== 0) {",
									"        pm.collectionVariables.set('presupuestoNro', presupuesto);",
									"        console.log('✅ presupuestoNro guardado: ' + presupuesto);",
									"    } else {",
									"        console.warn('⚠️ presupuestoNro es 0. Asegurate de enviar GrabarPresupuesto: true');",
									"    }",
									"    console.log('Coberturas disponibles:');",
									"    res.forEach(c => console.log(' - ' + c.planCobertura + ': ' + c.detalleCobertura + ' | Premio: $' + c.premio));",
									"} else {",
									"    console.error('❌ Respuesta inesperada:', JSON.stringify(res));",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"UsuarioId\": \"{{usuarioId}}\",\n  \"RazonSocial\": \"APELLIDO NOMBRE\",\n  \"NroDocumento\": \"12333444\",\n  \"Email\": \"cliente@gmail.com\",\n  \"CodigoProductor\": \"{{codigoProductor}}\",\n  \"CondicionFiscal\": 5,\n  \"Categoria\": 1,\n  \"CodigoInfoAuto\": \"9100011\",\n  \"CodigoVehiculoCMP\": 0,\n  \"CodigoUso\": 1,\n  \"idLocalidad\": {{idLocalidad}},\n  \"CodigoPostal\": \"{{codigoPostal}}\",\n  \"Anio\": 2024,\n  \"PoseeGNC\": false,\n  \"CodigoGNC\": 0,\n  \"ValorVehiculo\": 0,\n  \"CotizaAP\": false,\n  \"CantidadMeses\": 4,\n  \"GrabarPresupuesto\": true,\n  \"AplicarMaxDescuentos\": true,\n  \"Accesorios\": []\n}"
						},
						"url": {
							"raw": "{{base_url}}/Presupuesto/Vehiculo/Cotizar",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"Presupuesto",
								"Vehiculo",
								"Cotizar"
							]
						},
						"description": "Cotiza un vehículo. Requiere CodigoInfoAuto (código de InfoAuto/Argautos). Con GrabarPresupuesto:true retorna un presupuestoNro que se guarda automáticamente en {{presupuestoNro}}.\n\nTabla CondicionFiscal: 1=Monotributista, 2=IVA Resp. Inscripto, 5=Consumidor Final\nTabla CodigoUso: 1=Particular, 2=Remis, 4=Comercial, etc."
					},
					"response": []
