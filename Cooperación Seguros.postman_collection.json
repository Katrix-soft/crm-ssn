			"item": [
				{
					"name": "Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.access_token) {",
									"    pm.collectionVariables.set('token', res.access_token);",
									"    console.log('✅ Token guardado correctamente. Expira en: ' + res.expires_in + 's');",
									"} else {",
									"    console.error('❌ No se pudo obtener el token:', JSON.stringify(res));",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"clientSecret\": \"{{clientSecret}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/token",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"token"
							]
						},
						"description": "Obtiene el token OAuth2. Se guarda automáticamente en la variable {{token}} de la colección."
					},
					"response": []
				}
			]
		},
