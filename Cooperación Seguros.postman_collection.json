		{
			"name": "📋 Pólizas",
			"item": [
				{
					"name": "Consultar Movimientos",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.cod_respuesta === '0' && res.documentos && res.documentos.length > 0) {",
									"    const doc = res.documentos[0];",
									"    pm.collectionVariables.set('idPoliza', doc.idPoliza);",
									"    console.log('✅ idPoliza guardado: ' + doc.idPoliza);",
									"    console.log('Póliza: ' + doc.poliza + ' | Cliente: ' + doc.cliente + ' | Movimiento: ' + doc.tipoMovimiento);",
									"    if (res.documentos.length > 1) {",
									"        console.log('⚠️ Se encontraron ' + res.documentos.length + ' movimientos. Se guardó el primero. Ajustar manualmente si se necesita otro.');",
									"    }",
									"} else {",
									"    console.warn('⚠️ ' + res.msg_respuesta);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
